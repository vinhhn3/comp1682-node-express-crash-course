# Copy this file to .env when you want to change the defaults.
# The app runs without it: every value below has a development fallback.

PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/shop

# Use long random strings outside local development.
ACCESS_TOKEN_SECRET=dev-access-secret
REFRESH_TOKEN_SECRET=dev-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# The concept tab is served from here. One origin per line, comma separated.
CORS_ORIGINS=http://localhost:5173

# Seconds a cached product list stays warm.
CACHE_TTL=60
